<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.liumybatisplus.mapper.HotKeyMapper">
    
    <resultMap id="HotKeyResult" type="com.example.liumybatisplus.entity.HotKey">
        <result property="id" column="id"/>
        <result property="name" column="key_name"/>
        <result property="picUrl" column="pic_url"/>
    </resultMap>

    <select id="searchHotKeyList" parameterType="String" resultMap="HotKeyResult">
        select * from hot_key

    </select>

</mapper>